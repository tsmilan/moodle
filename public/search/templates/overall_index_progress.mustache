{{!
    @template core_search/overall_index_progress

    Renders an overall indexing progress bar aggregated across all search areas.

    Context variables required for this template:
    * progressbar  - rendered progress bar output
    * unknownareas - integer, count of areas excluded because counts are unavailable

    Example context (json):
    {
        "progressbar": "<div>...</div>",
        "unknownareas": 3
    }
}}
<div class="search-index-overall-progress mb-3">
    <h5>{{#str}}overallindexingprogress, search{{/str}}</h5>
    {{{progressbar}}}
    {{#unknownareas}}
    <br><small class="text-muted">
        {{#str}}overallprogressexcluded, search, {{unknownareas}}{{/str}}
    </small>
    {{/unknownareas}}
</div>
